# Variáveis de Ambiente para Deploy no Render
# Copie este arquivo e adicione as variáveis no painel do Render

# Node Version
NODE_VERSION=18.19.0

# Supabase Configuration
VITE_SUPABASE_URL=https://bkssobleshobcwnnipak.supabase.co
VITE_SUPABASE_PROJECT_ID=bkssobleshobcwnnipak

# IMPORTANTE: Copie o valor abaixo do arquivo .env local
# NÃO commite o arquivo .env no repositório!
VITE_SUPABASE_PUBLISHABLE_KEY=<COPIE_DO_ARQUIVO_ENV_LOCAL>

# Instruções:
# 1. No painel do Render, vá em "Environment"
# 2. Adicione cada variável acima
# 3. Para VITE_SUPABASE_PUBLISHABLE_KEY, copie o valor do seu arquivo .env local
# 4. Salve e faça deploy
