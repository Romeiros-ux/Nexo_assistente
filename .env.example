# ==========================================
# API CONFIGURATION
# ==========================================

# URL base da API backend
# Desenvolvimento: http://localhost:3001/api/v1
# Produção: https://seu-backend.onrender.com/api/v1
VITE_API_URL=http://localhost:3001/api/v1

# ==========================================
# SUPABASE CONFIGURATION (Para uso futuro)
# ==========================================

# URL do projeto Supabase
# VITE_SUPABASE_URL=https://your-project.supabase.co

# Chave pública (anon key) do Supabase
# VITE_SUPABASE_ANON_KEY=your-anon-key

# ==========================================
# FEATURE FLAGS (Opcional)
# ==========================================

# Habilitar modo debug
# VITE_DEBUG=false

# Habilitar logs da API
# VITE_API_LOGGING=false
