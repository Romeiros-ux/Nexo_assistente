# Configurações do Servidor
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database Configuration
DATABASE_PASSWORD=your-database-password

# CORS Configuration
# Desenvolvimento:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Produção (descomente e atualize com a URL real do frontend):
# ALLOWED_ORIGINS=https://seu-frontend.vercel.app,https://seu-frontend.netlify.app

# JWT Configuration (para implementação futura)
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=7d

# Logs
LOG_LEVEL=info
# OpenAI Configuration (FASE 2 - RAG Indexação Vetorial)
OPENAI_API_KEY=sk-proj-your-api-key-here
OPENAI_MODEL=text-embedding-3-large
OPENAI_DIMENSIONS=1536
OPENAI_MAX_TOKENS=8191
OPENAI_BATCH_SIZE=50

# Redis Configuration (FASE 2.5 - Background Jobs)
# OPÇÃO 1: Desenvolvimento (local) - Redis instalado localmente
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# OPÇÃO 2: Produção - REDIS_URL (Upstash, Heroku Redis, etc.)
# Descomente e use APENAS UMA das opções (URL ou HOST/PORT separados)
# REDIS_URL=rediss://default:password@touching-seahorse-12345.upstash.io:6380

# OPÇÃO 3: Produção - Variáveis separadas (Redis Cloud, AWS ElastiCache, etc.)
# REDIS_HOST=redis-12345.upstash.io
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password
# REDIS_DB=0

# NOTA: Se Redis não estiver disponível, o sistema funcionará sem fila (indexação síncrona)